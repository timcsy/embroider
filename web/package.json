{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "build:wasm": "wasm-pack build ../crates/stitch-wasm --target web --out-dir ../../web/src/lib/wasm --release",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "copy:fonts": "mkdir -p public/fonts && cp ../fonts/*.ttf public/fonts/",
    "predev": "npm run copy:fonts",
    "prebuild": "npm run copy:fonts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0"
  }
}
